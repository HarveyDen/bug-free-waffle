# Токен Telegram-бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456789:AAE...

# Google Maps Platform: один ключ с включёнными Directions API и Geocoding API
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Яндекс: ключ Геокодера (JavaScript API и HTTP Геокодер)
# https://developer.tech.yandex.ru/services
YANDEX_GEOCODER_API_KEY=

# Яндекс: ключ Маршрутизатора (Distance Matrix API и Маршрутизация)
YANDEX_ROUTER_API_KEY=
